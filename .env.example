# AvanceOS - exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais no servidor.

NODE_ENV=development

PORT=3001
JWT_SECRET=change-me

DATABASE_URL="sqlserver://localhost:1433;database=AvanceOSDB;user=sa;password=change-me;encrypt=false;trustServerCertificate=true"

THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
THROTTLE_SENSITIVE_LIMIT=5

FRONTEND_URL=http://localhost:8081
