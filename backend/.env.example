NODE_ENV=production
PORT=3001

# URL publica do frontend autorizada no CORS.
FRONTEND_URL="https://avanceos.exemplo.local"

# Lista de origens permitidas pelo CORS. Use virgula para multiplas origens.
CORS_ORIGIN="https://avanceos.exemplo.local"

# SQL Server
# DATABASE_URL e usado pelo Prisma CLI (migrations/generate) e tem prioridade sobre DB_*.
DATABASE_URL="sqlserver://<SQL_SERVER_HOST_OR_IP>:1433;database=AvanceOSDB;user=<SQL_USER>;password=<SQL_PASSWORD>;encrypt=true;trustServerCertificate=true"

# Alternativa para a aplicacao montar DATABASE_URL em runtime quando DATABASE_URL nao estiver definido.
DB_HOST="<SQL_SERVER_HOST_OR_IP>"
DB_PORT=1433
DB_NAME=AvanceOSDB
DB_USER="<SQL_USER>"
DB_PASSWORD="<SQL_PASSWORD>"
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# App/API e autenticacao
JWT_SECRET="<LONG_RANDOM_SECRET>"
JWT_EXPIRES_IN="8h"
ADMIN_EMAIL="admin@oficinaavance.com.br"
DEFAULT_USER_PASSWORD="<TEMPORARY_PASSWORD_OR_EMPTY>"
DEV_ADMIN_PASSWORD="<SEED_ONLY_TEMPORARY_PASSWORD>"

# Rate limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_SENSITIVE_LIMIT=5
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5

# Scripts opcionais de diagnostico
CHECK_USER_EMAIL="<USER_EMAIL_TO_CHECK>"
CHECK_USER_EMAILS="<USER1_EMAIL>,<USER2_EMAIL>"
CHECK_PASSWORDS="<PASSWORD_CANDIDATE_1>,<PASSWORD_CANDIDATE_2>"

# Futuro/opcional para ambientes de demonstracao.
# DEMO_MASTER_TOKEN="<OPTIONAL_DEMO_ONLY_TOKEN>"
